# Copy to .env and fill in ONE provider key
GOOGLE_API_KEY=
GROQ_API_KEY=

# provider:model  (any model langchain's init_chat_model supports)
MODEL=google_genai:gemini-2.5-flash
# Optional: different models per role
# MODEL_FINDER=google_genai:gemini-2.5-flash
# MODEL_JUDGE=groq:llama-3.3-70b-versatile

# Free-tier friendly throttling
REQUESTS_PER_SECOND=0.15
MAX_CONCURRENCY=4
MAX_JUDGED=60
